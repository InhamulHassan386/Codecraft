# Copy to server/.env (or .env in the project root). Never commit the real .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codecraft
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Admin panel sign-in (required before the Admin Projects module can be used)
ADMIN_EMAIL=admin@codecraftsolutions.com
ADMIN_PASSWORD=change-this-password
# Optional: a long random string. If empty, admin sessions reset when the API restarts.
ADMIN_SESSION_SECRET=
