# ── CodeCraft CMS API server ──────────────────────────────────
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string

# Default admin (used only on first boot when the admin table is empty)
ADMIN_EMAIL=admin@codecraftsolutions.com
ADMIN_PASSWORD=password

# ── MySQL / MariaDB connection ────────────────────────────────
# Fill these in and restart the server to use a real MySQL database.
# If MySQL is unreachable, the server automatically falls back to
# a local JSON file store (server/data/db.json) with the same features.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=codecraft_cms
